# Kalshi DEMO environment credentials
# Get these from https://demo.kalshi.co after signing up for a demo account
KALSHI_API_KEY=your_kalshi_api_key_id_here

# Path to your RSA private key file downloaded from Kalshi (PEM format)
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# Optional: if your key is password protected
KALSHI_PRIVATE_KEY_PASSWORD=

# FRED API key - register for a free key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# BLS API is free and does not strictly require a key for basic use,
# but registering one gives you higher rate limits. https://www.bls.gov/developers/
BLS_API_KEY=
